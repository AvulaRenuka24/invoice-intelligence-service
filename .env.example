# .env.example — copy to .env and fill in your values
# Never commit .env to git (it is listed in .gitignore).

# ---------------------------------------------------------------
# LLM Provider
# ---------------------------------------------------------------
# Which model provider to use at startup.
# Values: local | stub | tinyllama
LLM_PROVIDER=local

# Hugging Face model ID for the local Qwen provider
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# Hugging Face model ID for the optional TinyLlama provider
TINYLLAMA_MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# ---------------------------------------------------------------
# Resilience
# ---------------------------------------------------------------
# Seconds before a model call is aborted
REQUEST_TIMEOUT_S=30.0

# Number of retry attempts on transient errors
MAX_RETRIES=3

# Consecutive failures before the circuit breaker opens
BREAKER_THRESHOLD=5

# Seconds the breaker stays open before a probe is allowed
BREAKER_COOL_OFF_S=30.0

# ---------------------------------------------------------------
# Cache
# ---------------------------------------------------------------
# Maximum number of LLM responses to keep in memory
CACHE_MAX_SIZE=256

# ---------------------------------------------------------------
# Quality gates
# ---------------------------------------------------------------
# Confidence below this threshold marks an extraction as needs_review
CONFIDENCE_THRESHOLD=0.6

# ---------------------------------------------------------------
# Storage
# ---------------------------------------------------------------
# SQLite database path (review queue + import jobs)
DB_PATH=jobs.db

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------
# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
